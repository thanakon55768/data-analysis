# Optional; default is .data at project root. Set this variable in your terminal.
# DATA_DIR=C:/path/to/private/local-data

# Set these environment variables in the shell before launching uvicorn.
STORAGE_MODE=local
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-side Gemini settings. Set in the shell before starting uvicorn.
GEMINI_API_KEY=
GEMINI_MODEL=
